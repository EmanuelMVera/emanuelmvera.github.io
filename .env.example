# ─────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores
# ─────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://{{SITE_URL}}

# Resend — proveedor principal de email para el formulario de contacto
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@tudominio.com
RESEND_TO_EMAIL={{EMAIL}}

# Formspree — fallback si no usas Resend
# Obtener en: https://formspree.io
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
